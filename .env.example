# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# Mapbox (Interactive Route Map)
NEXT_PUBLIC_MAPBOX_TOKEN="pk...."

# Stripe (Payments)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# HubSpot (CRM)
HUBSPOT_ACCESS_TOKEN="pat-..."
HUBSPOT_PORTAL_ID="..."

# Resend (Outbound email)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="contact@mail.36zeroyachting.com"
NOTIFICATION_EMAIL="your-email@example.com"

# Postmark Inbound (Email-to-CRM ingestion)
# Configure an inbound stream in Postmark, set its webhook URL to
#   https://<host>/api/webhooks/postmark/inbound
# with these Basic Auth credentials. Postmark does not natively HMAC-sign
# inbound payloads — Basic Auth + HTTPS is the only barrier, so generate
# strong random values and never reuse the password elsewhere.
POSTMARK_INBOUND_BASIC_USER="postmark"
POSTMARK_INBOUND_BASIC_PASS="<long random secret>"

# Anthropic (Claude API) — used to parse inbound email bodies into draft leads
ANTHROPIC_API_KEY="sk-ant-..."
INBOUND_PARSE_MODEL="claude-haiku-4-5"

# File Storage (Vercel Blob or S3)
BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# Analytics - PostHog
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Analytics - Microsoft Clarity
NEXT_PUBLIC_CLARITY_PROJECT_ID="..."

# Analytics - Google Analytics 4
NEXT_PUBLIC_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"

# Error Tracking (Sentry)
NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
SENTRY_ORG="your-org"
SENTRY_PROJECT="36zero-yachting"
SENTRY_AUTH_TOKEN="sntrys_..."

# Site URLs
NEXT_PUBLIC_SITE_URL="https://36zero.yachting"
NEXT_PUBLIC_LAP_URL="https://lap.36zero.yachting"
